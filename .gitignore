# Dependencies
node_modules/
.pnpm-store/
# pnpm-only repo — never an npm/yarn lockfile
package-lock.json
yarn.lock

# Build output
dist/
build/
*.tsbuildinfo

# Environment / secrets
.env
.env.*
!.env.example
!.env.production.example

# Prisma
apps/api/prisma/*.db
apps/api/prisma/migrations/dev.db*

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Coverage / test
coverage/
.nyc_output/

# Editor / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Word temp lock files
~$*.docx

# Local doc text extractions (helper files)
_doc*.txt

# Cloud / uploads — runtime file storage for user uploads; never commit these.
# Anchored to the runtime locations so they do NOT ignore the source module
# apps/api/src/uploads/ (same folder name, but it is code and must be tracked).
/uploads/
/uploads-private/
/apps/api/uploads/
/apps/api/uploads-private/

.vercel
