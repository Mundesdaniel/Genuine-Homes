# Production environment for docker-compose.prod.yml — copy to .env.production
# and fill in real values. NEVER commit .env.production.

# Database (compose builds DATABASE_URL from these)
POSTGRES_USER=genuine
POSTGRES_PASSWORD=
POSTGRES_DB=genuine_homes

# Public origin(s) of the web app, comma-separated
CORS_ORIGINS=https://app.genuinehomes.ug
PUBLIC_API_URL=https://app.genuinehomes.ug

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Payments. Production refuses to boot without Flutterwave credentials
# (set PAYMENT_GATEWAY=mock only for a demo stack with fake payments).
PAYMENT_GATEWAY=flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Optional integrations
#CLOUDINARY_URL=
#AFRICASTALKING_API_KEY=
#AFRICASTALKING_USERNAME=
#SENTRY_DSN=
#LOG_LEVEL=info

# Host port the web container binds to
WEB_PORT=80
