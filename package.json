{
  "name": "genuine-homes",
  "version": "0.1.0",
  "private": true,
  "description": "Genuine Homes — a real estate rental & ownership platform for East Africa (Uganda first).",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  },
  "scripts": {
    "dev:api": "pnpm --filter @genuine-homes/api start:dev",
    "dev:web": "pnpm --filter @genuine-homes/web dev",
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @genuine-homes/shared build",
    "lint": "pnpm -r lint && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @genuine-homes/api prisma:migrate",
    "db:generate": "pnpm --filter @genuine-homes/api prisma:generate",
    "db:seed": "pnpm --filter @genuine-homes/api prisma:seed",
    "slides": "node scripts/generate-presentations.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.9.4",
    "typescript-eslint": "^8.62.1"
  }
}
