# ─── Application ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# pino log level (fatal|error|warn|info|debug|trace). Defaults: debug in dev, info in prod.
#LOG_LEVEL=info
# Comma-separated list of allowed CORS origins (web app, mobile dev server).
CORS_ORIGINS=http://localhost:5173
# Absolute origin the API is reachable at — used to build URLs for locally
# uploaded property images. Defaults to http://localhost:<PORT> if unset.
PUBLIC_API_URL=http://localhost:3000

# ─── Database (matches docker-compose.yml defaults) ───────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://genuine:genuine_dev_pw@localhost:5432/genuine_homes?schema=public

# ─── Redis (cache, rate limiting, BullMQ job queue) ───────────────────────
REDIS_URL=redis://localhost:6379
# Notification fan-out: redis (durable BullMQ queue, default) | inline (no Redis).
#NOTIFICATIONS_QUEUE=redis

# ─── Auth (JWT) ───────────────────────────────────────────────────────────
# Generate strong secrets, e.g. `openssl rand -base64 48`. NEVER commit real values.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_REFRESH_TTL=30d

# ─── Payments — Flutterwave (added in Stage 5) ────────────────────────────
# Gateway selection: mock | flutterwave. Unset → inferred (flutterwave when a
# secret key is present, else mock). Production refuses the mock unless set
# explicitly. See docs/payments-sandbox-runbook.md for the sandbox round-trip.
#PAYMENT_GATEWAY=flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# ─── Media — property image uploads ───────────────────────────────────────
# Leave CLOUDINARY_URL empty to store uploads on the local disk (served at
# /uploads). Set it to your Cloudinary connection string to upload to Cloudinary
# instead — then also install the SDK: `pnpm --filter @genuine-homes/api add cloudinary`.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# ─── Notifications (added later) ──────────────────────────────────────────
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# ─── Observability ────────────────────────────────────────────────────────
# Sentry error monitoring. Unset → disabled. (Web app: VITE_SENTRY_DSN at build.)
SENTRY_DSN=
