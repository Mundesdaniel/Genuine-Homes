# Base URL of the Genuine Homes API.
# Leave unset in development — the Vite dev server proxies /api to :3100.
# In production set the full URL, e.g. https://api.genuinehomes.ug/api
# VITE_API_URL=/api

# Prototype/demo mode. Set to "true" to run the identity-verification flow
# entirely in the browser (no API needed) so it's clickable on a static deploy.
# Leave unset/false for real deployments.
# VITE_PROTOTYPE=true
