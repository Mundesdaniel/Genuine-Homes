{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build:shared && pnpm --filter @genuine-homes/web build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://genuine-homes-api.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://genuine-homes-api.onrender.com/uploads/:path*"
    },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
